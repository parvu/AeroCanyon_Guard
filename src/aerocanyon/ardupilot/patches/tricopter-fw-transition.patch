diff --git a/ArduPlane/quadplane.cpp b/ArduPlane/quadplane.cpp
index 9982dfce04..9be885650e 100644
--- a/ArduPlane/quadplane.cpp
+++ b/ArduPlane/quadplane.cpp
@@ -1375,11 +1375,25 @@ float QuadPlane::assist_climb_rate_cms(void) const
     }
     climb_rate_cms = constrain_float(climb_rate_cms, -wp_nav->get_default_speed_down_ms() * 100.0, wp_nav->get_default_speed_up_ms() * 100.0);
 
-    // bring in the demanded climb rate over 2 seconds
-    const uint32_t ramp_up_time_ms = 2000;
-    const uint32_t dt_since_start = last_pidz_active_ms - last_pidz_init_ms;
-    if (dt_since_start < ramp_up_time_ms) {
-        climb_rate_cms = linear_interpolate(0, climb_rate_cms, dt_since_start, 0, ramp_up_time_ms);
+    // bring in the demanded climb rate over 2 seconds -- skipped for
+    // tiltrotors (AeroCanyon_Guard patch, 2026-09-05). This ramp assumes
+    // an airframe with a dedicated forward-thrust motor, where easing
+    // VTOL climb-rate authority in over 2s while the forward motor takes
+    // over is fine. A tiltrotor has no such motor -- it depends entirely
+    // on VTOL lift until real airspeed is reached -- so ramping this
+    // authority from zero right as assisted_flight engages guarantees a
+    // ~2s window with near-zero climb-rate correction at exactly the
+    // moment a sink is most likely to start. Root-caused via a live SITL
+    // crash: QTUN logs showed the commanded climb rate (ThI) collapse to
+    // near-zero the instant Ast (assisted_flight) went true, with the
+    // vehicle then sinking uncorrected until PSC's own velocity-error
+    // feedback caught up too late to prevent hitting the ground.
+    if (!tiltrotor.enabled()) {
+        const uint32_t ramp_up_time_ms = 2000;
+        const uint32_t dt_since_start = last_pidz_active_ms - last_pidz_init_ms;
+        if (dt_since_start < ramp_up_time_ms) {
+            climb_rate_cms = linear_interpolate(0, climb_rate_cms, dt_since_start, 0, ramp_up_time_ms);
+        }
     }
     
     return climb_rate_cms;
