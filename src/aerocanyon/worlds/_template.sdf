<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="urban_canyon">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <!-- The tricopter model (models/airspeed, included via model.sdf)
         declares a sensor of type "air_speed", but declaring the sensor
         alone doesn't make it publish anything -- like Imu/AirPressure/
         Magnetometer/NavSat above, each sensor TYPE needs its own system
         plugin loaded to actually compute and publish its data. This one
         was missing: PX4's GZBridge subscribes to the air_speed topic
         unconditionally, but nothing was ever publishing on it, so
         SYS_HAS_NUM_ASPD>0 could never see valid data (verified live:
         "Preflight Fail: Airspeed invalid", vehicle never armed). -->
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed" />
    <!-- Lets a Python client apply a one-off force to any named entity via
         gz.msgs.EntityWrench on /world/<world>/wrench(/persistent|/clear) --
         used by the wing-only vehicle to simulate a catapult toss (there is
         no physical catapult modelled; PX4's own launch-detection module is
         structurally unreachable from this project's OFFBOARD architecture,
         see catapult.py). Inert for every other vehicle: it only acts on
         entities a wrench message actually names. -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench" />

    <!-- Sistemul global de vânt -->
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_threshold>0.001</force_approximation_threshold>
      <default_wind><linear>0.0 0.0 0.0</linear></default_wind>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <!-- 600x200, centred at the origin (so the towers -- themselves
             centred at (0,0), see canyon_geometry.BUILDINGS -- stay in the
             middle of it): controller_node now requests AUTO_LAND as soon
             as the vehicle clears the last tower row (world east=55), not
             at the old, much-further-out mission exit waypoint. AUTO_LAND
             is a slow, largely wind-uncompensated descent (tens of
             seconds), and verified live that a single baseline run drifted
             from the world-east=55 trigger point all the way to
             world-east=180 by touchdown under the canyon's ~12-14 m/s
             crosswind -- past the previous 300x150 plane's own east edge
             at 150. 600x200 covers east in [-300,300], comfortably past
             that observed worst case with margin for run-to-run variance,
             and north in [-100,100] for lateral drift. -->
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>600 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>600 200</size></plane></geometry>
          <material><ambient>0.16 0.45 0.16 1</ambient><diffuse>0.16 0.45 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Catapult launch ramp (wing-only branch only): a static prop the
         vehicle spawns sitting on top of, nose pitched up, instead of flat
         on the ground -- see catapult.py's RAMP_ANGLE_DEG/RAMP_LENGTH_M/
         RAMP_RISE_M, the single source of truth this pose is hand-computed
         from (the world file is static text, it can't import them). Numbers
         here: length 2.5m, angle 12deg -> half_x=(L/2)*cos(angle)=1.2227,
         half_z=(L/2)*sin(angle)=0.2599, rise=L*sin(angle)=0.5198. The ramp's
         HIGH end sits exactly at CANYON_ENTRY (world x=-100, y=0 -- see
         canyon_geometry.CANYON_ENTRY and run_trial.SPAWN_XYZ, which is where
         the vehicle actually spawns), so its centre is offset back by
         half_x/half_z from there, at ground level (z=0) at its low end.
         Change any of catapult.py's three constants and these six numbers
         (box size x/z, pose x/z/pitch) need recomputing to match.

         VISUAL ONLY, deliberately no <collision>. The vehicle is teleport-
         spawned already sitting at the ramp's top pose (SPAWN_XYZ/
         SPAWN_POSE) -- it never actually slides down the ramp under contact
         physics, catapult.py tosses it with a wrench instead -- so a
         collision shape here was never needed. Learned live: it actively
         broke arming. The clearance math (run_trial's SPAWN_XYZ using the
         ramp's centreline RAMP_RISE_M, not its true top surface, which sits
         a further half-thickness above that along the incline) put the
         vehicle's own collision geometry slightly into the ramp's, and PX4
         reported a PERSISTENT "Preflight Fail: Attitude failure (roll)" for
         an entire 60s run -- despite a spawn pose with zero roll -- which is
         the signature of a spawn-time contact-response corrupting attitude,
         not a real flight problem. -->
    <model name="catapult_ramp">
      <static>true</static>
      <pose>-101.2227 0 0.2599 0 -0.20944 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.5 0.6 0.08</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--BUILDINGS-->

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
