        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 16.0 45.0</size></box></geometry>
          <material>
            <ambient>0.4 0.42 0.45 1</ambient>
            <diffuse>0.5 0.52 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="tower_1_n">
      <static>true</static>
      <pose>0.0 20.0 30.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 16.0 60.0</size></box></geometry>
        </collision>
        <visual name="visual">
