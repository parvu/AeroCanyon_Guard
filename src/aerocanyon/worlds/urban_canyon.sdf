<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="urban_canyon">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <!-- Sistemul global de vânt -->
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_threshold>0.001</force_approximation_threshold>
      <default_wind><linear>0.0 0.0 0.0</linear></default_wind>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    
    <model name="tower_0_n">
      <static>true</static>
      <pose>-45.0 20.0 22.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 16.0 45.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 16.0 45.0</size></box></geometry>
          <material>
            <ambient>0.4 0.42 0.45 1</ambient>
            <diffuse>0.5 0.52 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="tower_0_s">
      <static>true</static>
      <pose>-45.0 -20.0 22.5 0 0 0</pose>
      <link name="link">
