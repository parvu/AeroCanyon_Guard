<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="urban_canyon">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <!-- The tricopter model (models/airspeed, included via model.sdf)
         declares a sensor of type "air_speed", but declaring the sensor
         alone doesn't make it publish anything -- like Imu/AirPressure/
         Magnetometer/NavSat above, each sensor TYPE needs its own system
         plugin loaded to actually compute and publish its data. This one
         was missing: PX4's GZBridge subscribes to the air_speed topic
         unconditionally, but nothing was ever publishing on it, so
         SYS_HAS_NUM_ASPD>0 could never see valid data (verified live:
         "Preflight Fail: Airspeed invalid", vehicle never armed). -->
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed" />

    <!-- Sistemul global de vânt -->
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_threshold>0.001</force_approximation_threshold>
      <default_wind><linear>0.0 0.0 0.0</linear></default_wind>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 74 0 0 0</pose>
      <link name="link">
        <!-- 600x200, centred at the origin (so the towers -- themselves
             centred at (0,0), see canyon_geometry.BUILDINGS -- stay in the
             middle of it): controller_node now requests AUTO_LAND as soon
             as the vehicle clears the last tower row (world east=55), not
             at the old, much-further-out mission exit waypoint. AUTO_LAND
             is a slow, largely wind-uncompensated descent (tens of
             seconds), and verified live that a single baseline run drifted
             from the world-east=55 trigger point all the way to
             world-east=180 by touchdown under the canyon's ~12-14 m/s
             crosswind -- past the previous 300x150 plane's own east edge
             at 150. 600x200 covers east in [-300,300], comfortably past
             that observed worst case with margin for run-to-run variance,
             and north in [-100,100] for lateral drift. -->
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>600 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>600 200</size></plane></geometry>
          <material><ambient>0.16 0.45 0.16 1</ambient><diffuse>0.16 0.45 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    
    <model name="tower_0_n">
      <static>true</static>
      <pose>-45.0 20.0 96.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 16.0 45.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 16.0 45.0</size></box></geometry>
          <material>
            <ambient>0.76 0.69 0.55 1</ambient>
            <diffuse>0.83 0.76 0.61 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="tower_0_s">
      <static>true</static>
      <pose>-45.0 -20.0 96.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 16.0 45.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 16.0 45.0</size></box></geometry>
          <material>
            <ambient>0.76 0.69 0.55 1</ambient>
            <diffuse>0.83 0.76 0.61 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="tower_1_n">
      <static>true</static>
      <pose>0.0 20.0 104.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 16.0 60.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 16.0 60.0</size></box></geometry>
          <material>
            <ambient>0.76 0.69 0.55 1</ambient>
            <diffuse>0.83 0.76 0.61 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="tower_1_s">
      <static>true</static>
      <pose>0.0 -20.0 104.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 16.0 60.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 16.0 60.0</size></box></geometry>
          <material>
            <ambient>0.76 0.69 0.55 1</ambient>
            <diffuse>0.83 0.76 0.61 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="tower_2_n">
      <static>true</static>
      <pose>45.0 20.0 93.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 16.0 38.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 16.0 38.0</size></box></geometry>
          <material>
            <ambient>0.76 0.69 0.55 1</ambient>
            <diffuse>0.83 0.76 0.61 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="tower_2_s">
      <static>true</static>
      <pose>45.0 -20.0 93.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.0 16.0 38.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.0 16.0 38.0</size></box></geometry>
          <material>
            <ambient>0.76 0.69 0.55 1</ambient>
            <diffuse>0.83 0.76 0.61 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- PX4's own SITL startup script used to spawn the vehicle into this
         world dynamically via a gz service call (PX4_SIM_MODEL/
         PX4_GZ_MODEL_POSE env vars in run_trial.py's old PX4 launch) --
         no model was ever baked into this file. ArduPilot's SITL has no
         equivalent: ArduPilotPlugin expects its model already present in
         the world via <include>, connecting to it over its own FDM
         socket (see src/aerocanyon/models/tricopter_ap/model.sdf). PX4
         is gone from this repo entirely now, so there is no reason to
         keep a second PX4-only copy of this world -- baked in directly.
         run_trial.py's SPAWN_XYZ (canyon_geometry.CANYON_ENTRY horizontal
         position, GROUND_Z + 0.246 ground clearance) sets this pose to
         match. This block was previously missing from this template --
         urban_canyon.sdf had it hand-added directly, which the "never
         edit worlds/urban_canyon.sdf by hand: regenerate it" docstring in
         canyon_geometry.py explicitly warns against; a regeneration would
         have silently dropped the vehicle spawn. -->
    <include>
      <uri>model://tricopter_ap</uri>
      <pose>-100 0 74.246 0 0 0</pose>
    </include>
  </world>
</sdf>
