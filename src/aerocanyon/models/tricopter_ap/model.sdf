<?xml version="1.0" encoding="UTF-8"?>
<!-- Forked from ../tricopter/model.sdf (PX4 model) for the ArduPilot port,
     ardupilot-phase1 Task 3. Only the motor/tilt-servo PLUGIN blocks and
     the two tilting joints' <limit> ranges differ -- every visual,
     collision, inertial and sensor block below is copied unchanged. -->
<sdf version='1.5'>
  <model name='tricopter_ap'>
    <pose>0 0 0.246 0 0 0</pose>
    <link name='base_link'>
        <enable_wind>true</enable_wind>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- Task 5: CG moved forward from x=0 to x=0.11667 m. This is the
             ONLY inertial change from the PX4 model, and it is required by
             ArduPilot, not cosmetic.

             AP_MotorsTri::output_armed_stabilizing() (lines 202-204,
             266-268) gives all three motors the SAME thrust at zero
             roll/pitch demand -- it has no per-rotor moment arms, unlike
             PX4's control allocator, which is why the PX4 model could keep
             its CG at the origin. With the rotors at x=+0.35 (front pair)
             and x=-0.35 (rear), equal thrust about a CG at x=0 leaves a
             standing pitch moment of 0.35*F ~ 5.9 N.m at hover -- about
             40 rad/s^2 on Iyy=0.1459, which pitched the airframe over
             within ~1 s of leaving the ground (observed live before this
             fix).

             The balance point for equal thrust is the rotor centroid,
             (0.35 + 0.35 - 0.35)/3 = 0.11667 m. The motor/rotor link
             masses share that same centroid, so putting base_link's CG
             there puts the whole vehicle's CG there too. -->
        <pose>0.11666666666666667 0 0 0 0 0</pose>
        <mass>5</mass>
        <inertia>
          <ixx>0.197563</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1458929</iyy>
          <iyz>0</iyz>
          <izz>0.1477</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>-0.01 0 -0.08 0 0 0</pose>
        <geometry>
          <box>
            <size>0.55 2.144 0.05</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>1.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name='base_link_visual'>
        <pose>0.53 -1.072 -0.1 1.5707963268 0 3.1415926536</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://standard_vtol/meshes/x8_wing.dae</uri>
          </mesh>
        </geometry>
        <material> <!-- White-->
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
        </material>
      </visual>
      <visual name='left_motor_column'>
        <pose>0.18 0.35 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.4 0.03 0.03</size>
          </box>
        </geometry>
        <material> <!-- DarkGrey-->
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <visual name='right_motor_column'>
        <pose>0.18 -0.35 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.4 0.03 0.03</size>
          </box>
        </geometry>
        <material> <!-- DarkGrey-->
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <visual name='rear_motor_boom'>
        <pose>-0.18 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.4 0.03 0.03</size>
          </box>
        </geometry>
        <material> <!-- DarkGrey-->
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <!-- motor_rear was a static (non-tilting) nacelle visual here.
           Removed now that the rear rotor tilts: motor_1 (below) is a real
           link with its own visual that moves with the tilt joint, and a
           second, non-moving copy drawn on base_link would just double up
           / desync from it. -->
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>

      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <!-- Task 5: roll the IMU 180 deg so it reports in FRD (x fwd,
             y right, z down), the frame ArduPilot expects. Copied from
             ~/ardupilot_gazebo/models/iris_with_standoffs/model.sdf's own
             imu_sensor, which carries exactly this pose.

             A Gazebo IMU reports in the SENSOR frame. Without this pose
             that frame is base_link, i.e. FLU, and ArduPilotPlugin does
             NOT rotate the IMU itself -- only the pose/velocity path goes
             through <modelXYZToAirplaneXForwardZDown>. PX4's plugin did
             its own conversion, which is why the model it was forked from
             needed no pose here.

             The result was gyro pitch/yaw rates with inverted sign
             relative to the attitude ArduPilot computed: caught live on
             PID_TUNING telemetry, where the pitch rate controller read
             achieved=-0.52 rad/s at the same instant ATTITUDE's own pitch
             angle was climbing at +0.52 rad/s. Positive feedback in the
             rate loop -- the airframe pitched up, the controller pushed it
             further up, and it flipped every time. -->
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <include merge="true">
      <uri>model://airspeed</uri>
      <pose>0. 0. 0. 0. 0. 0.</pose>
    </include>
    <joint name='airspeed_joint' type='fixed'>
      <parent>base_link</parent>
      <child>airspeed_link</child>
      <pose relative_to="base_link">-0 0 0 0 0 0</pose>
    </joint>

    <link name='motor_0'>
      <pose>0.35 -0.35 0.045 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0166704</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0166704</iyy>
          <iyz>0</iyz>
          <izz>0.0167604</izz>
        </inertia>
      </inertial>
      <collision name='motor_0_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.035</length>
            <radius>0.02</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name='motor_0_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.035</length>
            <radius>0.02</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>
    </link>

    <joint name='motor_0_joint' type='revolute'>
      <child>motor_0</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <!-- Widened from the PX4 model's -0.2618..1.57 (-15..90 deg) to
             -0.3491..1.5708 rad (-20..+90 deg): motor_0 is the FRONT RIGHT
             tilt, driven by ArduPilotPlugin's front tilt <control> block
             below, which needs the full -20..+90 deg physical range
             (Q_TILT_YAW_ANGLE=20's hover yaw-trim sub-range plus the
             0..90 deg hover-to-cruise sweep), per Task 2's report. -->
        <limit>
          <lower>-0.3490658503988659</lower>
          <upper>1.5707963267948966</upper>
        </limit>
        <dynamics>
          <friction>1.0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <link name='rotor_0'>
      <pose>0.35 -0.35 0.07 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name='rotor_0_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.1</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name='rotor_0_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://standard_vtol/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
        <material>  <!-- Blue -->
          <ambient>0 0 1 1.0</ambient>
          <diffuse>0 0 1 1.0</diffuse>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>
    </link>
    <joint name='rotor_0_joint' type='revolute'>
      <child>rotor_0</child>
      <parent>motor_0</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <link name='motor_1'>
      <pose>-0.35 0 0.045 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0166704</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0166704</iyy>
          <iyz>0</iyz>
          <izz>0.0167604</izz>
        </inertia>
      </inertial>
      <collision name='motor_1_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.035</length>
            <radius>0.02</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name='motor_1_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.035</length>
            <radius>0.02</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>
    </link>

    <joint name='motor_1_joint' type='revolute'>
      <child>motor_1</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <!-- motor_1 is the REAR tilt, driven by ArduPilotPlugin's rear
             tilt <control> block below.

             Task 5 correction: Task 3 put this joint's range at
             +90..+200 deg, taking Task 2's rear angles as SDF joint
             angles. They are not. Task 2's rear datum is the SPEC's
             vehicle-description convention, in which the rear reads
             180 deg when pointing UP and 90 deg when pointing forward
             -- i.e. offset 180 deg from this SDF's, because rotor_1's
             link pose here has NO 180 deg mounting rotation baked in
             (see <link name='rotor_1'><pose>-0.35 0 0.07 0 0 0</pose>:
             identity rotation, +z up, exactly like the front rotors).
             With the old range the rear rotor sat inverted at hover and
             pushed DOWN, flipping the airframe within ~2 s of arming --
             observed live before this fix.

             So the rear uses the SAME SDF range as the front: 0 rad =
             upright/hover, +pi/2 = tilted forward for cruise. The
             ArduPilot-side 180 deg offset lives entirely in the
             <control> block's multiplier/offset below. -->
        <limit>
          <lower>-0.3490658503988659</lower>
          <upper>1.5707963267948966</upper>
        </limit>
        <dynamics>
          <friction>1.0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <link name='rotor_1'>
      <pose>-0.35 0 0.07 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name='rotor_1_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.1</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name='rotor_1_visual'>
        <!-- Real request: rotor_1 (rear) is a pusher prop, not a puller --
             the blade mesh should sit on the trailing side of the motor
             housing (motor_1, whose collision cylinder centers at
             z=0.045 in the model's rest frame) rather than the leading
             side. Inherited unchanged from the stock tiltrotor mesh
             before this session's rear-tilt rework, the prop rendered at
             the SAME +0.025 offset above the housing centre as the front
             (puller) rotors -- correct for them, backwards for a pusher.

             A -0.05 local offset (mirroring the front's +0.025 around the
             link's z=0.07 origin) put the blade disk's own centre below
             the housing centre, but its ~0.1 m sweep radius still crossed
             above the housing's TOP edge and the mount boom's top surface
             (rear_motor_boom, whose visual bbox tops out level with where
             the blade landed) in a live screenshot -- confirmed by
             comparing scene-graph world-space bounding boxes for
             rotor_1_visual/motor_1_visual/rear_motor_boom, not guessed.
             Real request 2026-09-02: still visibly above its support.
             Deepened to -0.09 so the whole disk clears the boom's bottom
             surface (not just the motor's centre-line) with margin,
             instead of only nudging past the housing centre. Purely
             cosmetic -- does not touch the collision/inertial placement
             above, the joint definition, or the ArduPilotPlugin/LiftDrag
             thrust mechanism, all of which stay keyed to the link's own
             origin. -->
        <pose>0 0 -0.09 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://standard_vtol/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
        <material>  <!-- Blue -->
          <ambient>0 0 1 1.0</ambient>
          <diffuse>0 0 1 1.0</diffuse>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>
    </link>
    <joint name='rotor_1_joint' type='revolute'>
      <child>rotor_1</child>
      <parent>motor_1</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <link name='motor_2'>
      <pose>0.35 0.35 0.045 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0166704</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0166704</iyy>
          <iyz>0</iyz>
          <izz>0.0167604</izz>
        </inertia>
      </inertial>
      <collision name='motor_2_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.035</length>
            <radius>0.02</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name='motor_2_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.035</length>
            <radius>0.02</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>
    </link>

    <joint name='motor_2_joint' type='revolute'>
      <child>motor_2</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <!-- motor_2 is the FRONT LEFT tilt -- same -20..+90 deg range as
             motor_0_joint (front right) above, see that joint's comment. -->
        <limit>
          <lower>-0.3490658503988659</lower>
          <upper>1.5707963267948966</upper>
        </limit>
        <dynamics>
          <friction>1.0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <link name='rotor_2'>
      <pose>0.35 0.35 0.07 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <collision name='rotor_2_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.1</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name='rotor_2_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://standard_vtol/meshes/iris_prop_cw.dae</uri>
          </mesh>
        </geometry>
        <material> <!-- DarkGrey-->
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay />
      <self_collide>0</self_collide>
    </link>
    <joint name='rotor_2_joint' type='revolute'>
      <child>rotor_2</child>
      <parent>motor_2</parent>
