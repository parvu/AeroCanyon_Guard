    <!-- Wired up 2026-09-04 -- live-caught via Mission Planner showing
         no rudder output ("servo 4"). Previously disabled (both blocks
         commented out) with sub_topic=servo_5 (SERVO6), which today's
         motor SERVO-remapping (see tricopter.parm) claimed for the
         front-left motor -- would have driven the rudder off the
         front-left motor's throttle command if just uncommented as-is.
         SERVO4 (index 3, topic servo_3) is genuinely free and is
         ArduPlane's own compiled default k_rudder channel already,
         matching what Mission Planner shows without needing any
         tricopter.parm change. -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_joint</joint_name>
      <sub_topic>servo_3</sub_topic>
    </plugin>
    <!-- Task 5: this plugin is what makes the three tilt servos work at
         all. ArduPilotPlugin's POSITION + useForce=1 path reads the
         joint's gz::sim::components::JointPosition component
         (ArduPilotPlugin.cc:1368-1379) and does NOTHING AT ALL if that
         component is absent -- and the plugin only ever creates
         JointForceCmd / JointVelocityCmd for its controls (same file,
         :413-438), never JointPosition. Nothing else in this model
         touches the three tilt joints, so the component never existed and
         all three <control type="POSITION"> blocks were silent no-ops:
         ArduPilot swung its vectored-yaw command across a third of its
         range while the joints sat at exactly 0.0 deg and the airframe
         wound up to 2.1 rad/s of yaw -- measured live off
         /world/urban_canyon/dynamic_pose/info.

         JointStatePublisher creates JointPosition for every joint it is
         given, which is all this needs; the published joint_state topic
         itself is a harmless side effect. Listing only the three tilt
         joints -- the rotor joints use VELOCITY, which reads JointVelocity
         (already populated by the physics system) and works as-is. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>motor_0_joint</joint_name>
      <joint_name>motor_1_joint</joint_name>
      <joint_name>motor_2_joint</joint_name>
    </plugin>

    <!-- Rotor thrust rig, ardupilot-phase1 Task 5 (Step 0).
         ArduPilotPlugin's VELOCITY <control> blocks below only spin the
         rotor JOINTS (ApplyMotorForces() writes JointForceCmd, never a
         Wrench on base_link) -- they generate zero lift on their own.
         These LiftDrag blocks are what turns that spin into thrust, the
         same rig ~/ardupilot_gazebo/models/iris_with_ardupilot/model.sdf
         uses. Two blocks per rotor at opposite cp (as iris does) so the
         off-axis moments of the two half-forces cancel instead of shaking
         the airframe at rotor frequency.

         Coefficients (a0, cla, cda, alpha_stall, cl/cd_stall, area,
         air_density) are iris_with_ardupilot's verified-working values
         verbatim. ONLY the cp radius is sized for this vehicle, so that
         thrust matches the PX4 model's own live-tuned sizing
         (../tricopter/model.sdf: motorConstant=1.608e-05,
         maxRotVelocity=1500 -> 1.608e-05 * 1500^2 = 36.2 N per rotor at
         full command):

           F_rotor = 2 * 0.5 * rho * (omega*r)^2 * area * (cla * a0)
                   = 2 * 0.5 * 1.2041 * (1500 r)^2 * 0.002 * 1.275
                   = 6908 * r^2   [N]
           36.2 N  ->  r = 0.0724 m  (0.72 of the 0.1 m rotor radius --
                                      a physically sensible effective
                                      blade station, not a fudge)

         Vehicle mass is 5.165 kg (50.7 N), so 3 x 36.2 N = 108.5 N gives
         a ~2.1 thrust/weight ratio and a hover at ~47% thrust.

         `forward` must point the way the cp actually travels for that
         rotor's sign of rotation, or the block produces DOWNforce:
         rotor_0/rotor_1 have multiplier +1500 (ccw), rotor_2 has -1500
         (cw), so rotor_2's forward vectors are flipped -- exactly the
         convention iris uses between its own rotor_0/1 and rotor_2/3. -->
    <!-- rotor_0 -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.0724 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.0724 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>
    <!-- rotor_1 -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.0724 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_1</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.0724 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_1</link_name>
    </plugin>
    <!-- rotor_2 -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.0724 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_2</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.0724 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_2</link_name>
    </plugin>

    <!-- ArduPilot integration, ardupilot-phase1 Task 3.
         Replaces all six PX4 plugins that used to drive the three rotor
         joints (rotor_0/1/2_joint, via gz-sim-multicopter-motor-model-
         system) and the three tilt joints (motor_0/1/2_joint, via
         gz-sim-joint-position-controller-system) with ONE ArduPilotPlugin
         block, matching the working pattern in
         ~/ardupilot_gazebo/models/iris_with_ardupilot/model.sdf (motor
         VELOCITY controls) and .../zephyr_with_ardupilot/model.sdf
         (POSITION controls for control surfaces, same PID shape used
         below for the tilt servos) -- both installed, buildable
         references, read directly rather than guessed at.

         Rotor thrust: this plugin only spins/positions joints via a
         force-mode PID (useForce=1); it does not compute aerodynamic
         thrust from that spin the way the deleted MulticopterMotorModel
         plugin did (motorConstant * velocity^2). Task 5 added the six
         LiftDrag blocks directly above to supply that missing force --
         they are load-bearing, not decoration; delete them and the
         vehicle cannot leave the ground.

         Link/joint names (rotor_0/1/2, motor_0/1/2_joint) and physical
         positions are unchanged from ../tricopter/model.sdf:
           motor_0 = FRONT RIGHT (0.35, -0.35), rotor_0 spins ccw
           motor_1 = REAR        (-0.35, 0),    rotor_1 spins ccw
           motor_2 = FRONT LEFT  (0.35, 0.35),  rotor_2 spins cw
         matching Task 2's AP_MotorsTri ordering (front right / front left
         / rear) and turning directions already baked into the PX4 mesh
         choices (iris_prop_ccw.dae vs iris_prop_cw.dae) above. -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <!-- 0.0.0.0, not 127.0.0.1: accepts the JSON-FDM connection from a
           SITL instance running on the Windows host (outside WSL), where
           127.0.0.1 refers to Windows itself, not this WSL VM. The
           Windows-side SITL still needs to target this VM's actual IP
           (`hostname -I` in WSL -- changes across reboots) rather than
           127.0.0.1 for the other half of this to work. -->
      <fdm_addr>0.0.0.0</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <imuName>base_link::imu_sensor</imuName>

      <!-- Motor thrust controls -- type VELOCITY, matching the PX4
           model's velocity-based MulticopterMotorModel setup (Step 3's
           mandated choice) and iris_with_ardupilot's own VELOCITY
           controls. multiplier=1500 matches the deleted plugins'
           <maxRotVelocity>1500</maxRotVelocity> so a full-scale [0,1]
           command asks for the same top rotor speed as before; sign
           follows each rotor's real turning direction (ccw positive, cw
           negative), the same convention iris_with_ardupilot uses for
           its own ccw/cw rotor pairs. p_gain=0.20 is iris_with_ardupilot's
           verified-working value, not independently tuned here -- Step 2
           of the brief is explicit that these numbers are a structurally-
           valid starting point, empirically confirmed only once Gazebo+
           SITL actually fly (Task 5), the same way CA_ROTORi_CT needed
           live tuning on the PX4 branch.

           Channel numbers here follow Task 2's live SITL channel
           assignment (SERVO5/6/8 -> M1 front-right/M2 front-left/M4 rear,
           1-indexed servo output -> 0-indexed fdm channel = SERVOn - 1).
           Task 4 assigns SERVOn_FUNCTION independently and may not
           reproduce these exact numbers -- what this SDF actually
           depends on is the angle/velocity mapping per channel, not the
           channel number itself. -->
      <!-- Thrust margin raised 2026-09-05, at the user's request after
           live manual flight (Mission Planner) never got past ~7 m/s
           cruise regardless of throttle -- matching this project's own
           earlier drag/thrust math (rear motor's real max thrust vs
           parasitic+induced drag at cruise speed came out to only ~3.7%
           margin). The real thrust source here is the six per-rotor
           LiftDrag "propeller blade" plugins above (link_name=rotor_N),
           driven by each rotor_N_joint's actual angular velocity -- NOT
           the motorConstant*velocity^2 figure in this file's older
           comments, which described a DELETED plugin kept only as a
           stale reference number. Two real levers on that thrust, both
           raised together: multiplier (the commanded top rotor angular
           velocity at full throttle, 1500->1800, +20%) and cmd_max/
           cmd_min (the PID's torque authority to actually REACH that
           velocity against the blades' own aerodynamic drag load,
           2.5->8.0 N*m, raised further still at the user's request for
           more headroom to reliably reach the new target -- kept
           symmetric/negative on cmd_min: this bounds the velocity PID's
           corrective torque, not motor thrust direction, and needs to
           go negative to brake an overshooting rotor regardless of
           which way the target itself spins) -- raising multiplier
           alone without more torque
           authority would just mean the PID can't climb to the new
           target and steady-state thrust barely changes. Since thrust
           from a blade-element LiftDrag model scales with velocity
           squared, +20% velocity is a real ~+44% thrust ceiling, not a
           token bump. All three motors scaled together (not just rear)
           to preserve the existing front/rear pitch-factor balance
           (0.5/-1.0, tuned assuming identical motor characteristics) --
           singling out rear would reintroduce a new asymmetry. -->
      <control channel="4"> <!-- SERVO5: motor 1 = front right -->
        <jointName>rotor_0_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1800</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>8.0</cmd_max>
        <cmd_min>-8.0</cmd_min>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </control>
      <control channel="5"> <!-- SERVO6: motor 2 = front left -->
        <jointName>rotor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-1800</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>8.0</cmd_max>
        <cmd_min>-8.0</cmd_min>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </control>
      <control channel="7"> <!-- SERVO8: motor 4 = rear -->
        <jointName>rotor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1800</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>8.0</cmd_max>
        <cmd_min>-8.0</cmd_min>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </control>

      <!-- Tilt-servo controls -- type POSITION, useForce=1 (a PID drives
           JointForceCmd toward a target JointPosition in radians; this is
           the only working POSITION path in ArduPilotPlugin.cc -- pure
           position-mode without useForce warns "no JointPositionCmd
           component" and does nothing, confirmed by reading
           ApplyMotorForces() in ~/ardupilot_gazebo/src/ArduPilotPlugin.cc).

           cmd (target radians) = multiplier * (raw_cmd + offset), where
           raw_cmd = clamp((pwm - servo_min)/(servo_max - servo_min), 0, 1)
           -- see UpdateMotorCommands() in the same file. Both front and
           rear use servo_min=1000/servo_max=2000 and a 110 deg (1.9199
           rad) span, per Task 2's report ("both tilt joints share a 0.11
           deg/us PWM scale"); only the offset differs, since it's the
           same linear scale positioned at a different point on the
           shared axis:

             front (motor_0_joint, motor_2_joint): PWM 1000->-20 deg,
             PWM 2000->+90 deg.
               multiplier = (90 - -20) deg in rad = 1.9198621771937625
               offset     = -20 deg in rad / multiplier = -0.18181818...
               check: raw=0 -> -0.349066 rad (-20 deg); raw=1 -> 1.570796
               rad (+90 deg). Matches Task 2's verified hover waypoint
               (PWM 1181 -> 0 deg) and the widened motor_0/2_joint
               <limit> above.

             rear (motor_1_joint): Task 2's wire-verified waypoints are
             PWM 1000 -> "90 deg" (cruise, thrust forward) and PWM 1818
             -> "180 deg" (hover, thrust up), in the SPEC's rear-datum
             convention. In THIS SDF's joint convention 0 rad is upright
             (rotor_1's link pose carries no 180 deg mounting rotation),
             so subtract 180 deg from both: PWM 1818 -> 0 rad and
             PWM 1000 -> +pi/2, the same +pi/2 = forward the front pair
             uses. That makes the rear's PWM->angle slope NEGATIVE, hence
             the negative multiplier -- the only sign inversion in this
             file, and it is a real physical one, not a duplicate of
             SERVO14_REVERSED=1 (which is already baked into the PWM Task
             2 measured on the wire):
               multiplier = -1.9198621771937625 (same 110 deg span, reversed)
               offset     = -0.8181818181818182
               check: raw=0    -> +1.570796 rad (+90 deg, cruise)
                      raw=0.818-> +0.000000 rad (hover, PWM 1818)
                      raw=1    -> -0.349066 rad (-20 deg, unused end)
             Task 5 fix: Task 3's +1.9199/+0.8182 pair put the rear rotor
             at +180 deg (inverted, thrusting DOWN) at hover; the vehicle
             flipped within ~2 s of arming until this was corrected.

           Task 5 retuned these from zephyr_with_ardupilot's p_gain=10.0 /
           cmd_max=2.5 (Task 3 copied them and flagged them as untuned for
           this heavier joint). zephyr drives a near-frictionless control
           surface; these tilt joints carry <friction>1.0</friction>, so a
           P-only controller capped at 2.5 N.m needed a 0.25 rad error just
           to reach the cap and could not break static friction for the few
           degrees of vectored-yaw trim ArduPilot actually asks for. The
           joints stayed pinned at hover position, the yaw loop saw no
           response, wound its command open-loop, and the airframe spun up
           to 0.74 rad/s of yaw while climbing -- observed live.

           p_gain=500 puts the stick-slip deadband at 1.0/500 = 0.002 rad
           (0.11 deg); at p_gain=100 the residual +-0.57 deg deadband showed
           up as a slow +-8 deg yaw limit cycle in flight. cmd_max=20 N.m
           leaves headroom to slew, d_gain=5.0 damps the stiff loop. -->
      <control channel="11"> <!-- SERVO12: k_tiltMotorRight -> front right -->
        <jointName>motor_0_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.9198621771937625</multiplier>
        <offset>-0.18181818181818182</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>500.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>5.0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>20.0</cmd_max>
        <cmd_min>-20.0</cmd_min>
      </control>
      <control channel="12"> <!-- SERVO13: k_tiltMotorLeft -> front left -->
        <jointName>motor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.9198621771937625</multiplier>
        <offset>-0.18181818181818182</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>500.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>5.0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>20.0</cmd_max>
        <cmd_min>-20.0</cmd_min>
      </control>
      <control channel="13"> <!-- SERVO14: k_scripting1 (Lua tricopter_mixer) -> rear tilt
           2026-09-04: multiplier/offset were negated relative to front
           (-1.9198.../-0.8181... vs front's +1.9198.../-0.1818...),
           calibrated back when this channel was k_tiltMotorRear with
           SERVO14_REVERSED=1. This session repurposed SERVO14 to
           k_scripting1 with SERVO14_REVERSED=0 so tricopter_mixer.lua
           can own the rear tilt directly -- the joint's own comment
           above states front and rear share the identical SDF
           convention (0 rad=hover, +pi/2=cruise), so with REVERSED=0
           the rear now needs the SAME calibration as front, not its
           negation. Left uncorrected, the Lua script's hover-tilt PWM
           (1000, meant to command 0 rad) instead computed to -0.818 rad
           -- outside the joint's [-0.349, +1.5708] limit -- and clamped
           near the lower bound instead of sitting upright. -->
        <jointName>motor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.9198621771937625</multiplier>
        <offset>-0.18181818181818182</offset>
        <servo_min>1200</servo_min>
        <servo_max>1900</servo_max>
        <type>POSITION</type>
        <p_gain>500.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>5.0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>20.0</cmd_max>
        <cmd_min>-20.0</cmd_min>
      </control>
    </plugin>
    <static>0</static>
  </model>
</sdf>
