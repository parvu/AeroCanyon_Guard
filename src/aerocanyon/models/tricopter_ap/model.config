<?xml version="1.0"?>
<model>
  <name>tricopter_ap</name>
  <version>1.0</version>
  <sdf version='1.4'>model.sdf</sdf>

  <author>
   <name>Pernilla Wikström</name>
   <email>pernilla@auterion.com</email>
  </author>

  <description>
    ArduPilot port of the tricopter VTOL (E-flite Convergence style): three
    tilting rotors -- two front (which also provide yaw via differential
    tilt) and one rear. Same geometry/visual/inertial/sensor blocks as
    ../tricopter (the PX4 model), driven instead by a single ArduPilotPlugin
    (see model.sdf comments for the tilt-servo angle mapping and motor
    control choices, resolved in the ardupilot-phase1 Task 2 geometry
    spike).
  </description>
</model>
