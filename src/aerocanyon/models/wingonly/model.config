<?xml version="1.0"?>
<model>
  <name>wingonly</name>
  <version>1.0</version>
  <sdf version='1.4'>model.sdf</sdf>

  <author>
   <name>Pernilla Wikström</name>
   <email>pernilla@auterion.com</email>
  </author>

  <description>
    Pure fixed-wing, catapult-launched: no tilt rotors at all, a single
    fixed rear pusher along the fuselage's longitudinal axis, roll/pitch/yaw
    from ailerons/elevator/rudder. Derived from this project's tricopter
    model (itself derived from PX4's stock quad tiltrotor) by removing both
    front tilting rotors and re-orienting the remaining rear rotor from a
    vertical hover thrust axis to a forward pusher thrust axis.
  </description>
</model>
