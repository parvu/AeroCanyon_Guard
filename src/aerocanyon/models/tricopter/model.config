<?xml version="1.0"?>
<model>
  <name>tricopter</name>
  <version>1.0</version>
  <sdf version='1.4'>model.sdf</sdf>

  <author>
   <name>Pernilla Wikström</name>
   <email>pernilla@auterion.com</email>
  </author>

  <description>
    Tricopter VTOL in the style of the E-flite Convergence: three tilting
    rotors -- two front (which also provide yaw via differential tilt) and
    one rear (an active pusher in cruise, sized to half the vehicle's
    weight). Derived from the stock quad tiltrotor model.
  </description>
</model>
